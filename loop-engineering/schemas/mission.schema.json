{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-engineering.local/schemas/mission.schema.json",
  "title": "LOOP ENGINEERING Mission",
  "type": "object",
  "required": ["id", "objective", "completion_contract", "risk_level", "state"],
  "properties": {
    "id": {"type": "string", "pattern": "^MIS-[A-Z0-9]+$"},
    "objective": {"type": "string", "minLength": 1},
    "completion_contract": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "risk_level": {"enum": ["low", "medium", "high", "mission-critical"]},
    "state": {"enum": ["draft", "validated", "planned", "active", "blocked", "release-ready", "released", "closed", "retired"]},
    "activated_asset_ids": {"type": "array", "items": {"type": "string"}},
    "human_approval_required": {"type": "boolean"},
    "rollback_plan": {"type": "string"}
  },
  "additionalProperties": true
}
